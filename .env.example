# Postgres connection string.
# Local dev: point this at your own Postgres, or at the same Vercel Postgres
# instance you provision for production (see README for how to get it).
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Session signing secret. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-generated-secret"

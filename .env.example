# Postgres connection string (pooled - used for normal app queries).
# Local dev: point this at your own Postgres, or at the same Vercel Postgres
# instance you provision for production (see README for how to get it).
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Direct (non-pooled) connection string - required for migrations.
# Neon's Vercel integration provides this automatically as
# DATABASE_URL_UNPOOLED. For a plain local Postgres, this can be the
# same value as DATABASE_URL above.
DATABASE_URL_UNPOOLED="postgresql://user:password@host:5432/dbname"

# Session signing secret. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-generated-secret"
